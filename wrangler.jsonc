{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aura",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Все адреса, кроме файлов статики, идут через Worker: он отвечает на /api/*
    // и подставляет SEO-метаданные в HTML страниц (worker/seo.ts)
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg", "!/og.png"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    // Публичный адрес сайта — для canonical, sitemap и Open Graph
    "SITE_URL": "https://aura.free-edu.workers.dev",
    // Вход через Google: Client ID не секрет. Секрет — GOOGLE_CLIENT_SECRET (в секретах Worker'а).
    "GOOGLE_CLIENT_ID": "1019406872656-gbj6k8mfb46if90u4hq6atk7ek6k89dm.apps.googleusercontent.com",
    // Основная модель Workers AI и её цена в нейронах за 1M токенов (см. Workers AI pricing)
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AI_NEURONS_PER_M_INPUT": "9091",
    "AI_NEURONS_PER_M_OUTPUT": "27273",
    // Бесплатно 10 000 нейронов в день — останавливаемся раньше, с запасом
    "AI_DAILY_NEURON_BUDGET": "9000",
    "AI_USER_DAILY_LIMIT": "15",
    // Резервный провайдер. Ключ задаётся секретом GEMINI_API_KEY (не в этом файле)
    "GEMINI_MODEL": "gemini-flash-latest"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura-db",
      "database_id": "22053238-5d86-442b-8ad2-04f2767efa2a",
      "migrations_dir": "migrations"
    }
  ]
}
