{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aura",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // React-роуты отдают index.html, /api/* всегда идёт в Worker
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    // Основная модель Workers AI и её цена в нейронах за 1M токенов (см. Workers AI pricing)
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AI_NEURONS_PER_M_INPUT": "9091",
    "AI_NEURONS_PER_M_OUTPUT": "27273",
    // Бесплатно 10 000 нейронов в день — останавливаемся раньше, с запасом
    "AI_DAILY_NEURON_BUDGET": "9000",
    "AI_USER_DAILY_LIMIT": "15",
    // Резервный провайдер. Ключ задаётся секретом GEMINI_API_KEY (не в этом файле)
    "GEMINI_MODEL": "gemini-flash-latest"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura-db",
      "database_id": "22053238-5d86-442b-8ad2-04f2767efa2a",
      "migrations_dir": "migrations"
    }
  ]
}
